# Copy to .env and fill in. Never commit .env.
SEASHIELD_ENV=dev

# MQTT
SEASHIELD_MQTT_HOST=mosquitto
SEASHIELD_MQTT_PORT=1883
SEASHIELD_MQTT_TLS=false
SEASHIELD_MQTT_USERNAME=
SEASHIELD_MQTT_PASSWORD=

# PostgreSQL
POSTGRES_USER=seashield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seashield
SEASHIELD_DATABASE_URL=postgresql+psycopg://seashield:change-me@postgres:5432/seashield

# Security engine
SEASHIELD_BUOYS_FILE=config/buoys.yaml
SEASHIELD_KEYS_FILE=secrets/buoy_keys.json
SEASHIELD_REPLAY_WINDOW_S=120

# Simulator
SEASHIELD_PUBLISH_INTERVAL_S=2.0

# Public domain for HTTPS (Phase 9, Vultr). "localhost" for local dev.
SEASHIELD_DOMAIN=localhost
