# Automatic HTTPS via Let's Encrypt when SEASHIELD_DOMAIN is a real domain.
# With "localhost", Caddy uses a local self-signed certificate.
{$SEASHIELD_DOMAIN:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
